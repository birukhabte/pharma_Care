{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"paths": {
			"@/components/*": ["src/components/*"],
			"@/styles/*": ["src/styles/*"],
			"@/app/*": ["src/app/*"]
		}
	},
	"include": ["next-env.d.ts", "src/**/*.{ts,tsx}"],
	"exclude": ["node_modules"]
}

